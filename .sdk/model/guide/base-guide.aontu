# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 3
  metrics: count: path: 6
  metrics: count: method: 7

  entity: calculator: {
    path: "/mcp/tools/calculate": {
      op: create: method: *POST
      op: create: transform: req: "arrFeePct": *("`reqdata.arr_fee_pct`")|top
      op: create: transform: req: "loan": *("`reqdata.loan`")|top
      op: create: transform: req: "margin": *("`reqdata.margin`")|top
      op: create: transform: req: "otherFees": *("`reqdata.other_fee`")|top
      op: create: transform: req: "rent": *("`reqdata.rent`")|top
      op: create: transform: req: "term": *("`reqdata.term`")|top
      op: create: transform: req: "value": *("`reqdata.value`")|top
    }
    path: "/mcp/tools/calculator_describe": {
      op: create: method: *POST
    }
  }

  entity: enquiry: {
    path: "/mcp/tools/enquiry_describe": {
      op: create: method: *POST
    }
    path: "/mcp/tools/enquiry_fields": {
      op: create: method: *POST
    }
    path: "/mcp/tools/submit_enquiry": {
      op: create: method: *POST
      op: create: transform: req: "answers": *("`reqdata.answer`")|top
      op: create: transform: req: "confirmation": *("`reqdata.confirmation`")|top
      op: create: transform: req: "consent": *("`reqdata.consent`")|top
    }
  }

  entity: mcp: {
    path: "/mcp": {
      op: create: method: *POST
      op: load: method: *GET
    }
  }

}